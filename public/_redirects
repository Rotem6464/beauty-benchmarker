# SPA fallback routing for Netlify and Cloudflare Pages
# Static files are served directly with force flag, all other routes serve index.html

# Static files - served directly with correct MIME types (! forces the rule)
/robots.txt    /robots.txt    200!
/sitemap.xml   /sitemap.xml   200!
/favicon.ico   /favicon.ico   200!

# SPA fallback - all other routes serve index.html
/*    /index.html   200
